FROM node:20-alpine AS builder
RUN apk add --no-cache python3 make g++ git
WORKDIR /app
COPY scanners/package.json scanners/package-lock.json* ./
COPY scanners/tsconfig.json ./
COPY scanners/src ./src
COPY shared /shared
RUN npm ci --ignore-scripts && npm run build && npm prune --production

FROM node:20-alpine AS runtime
RUN apk add --no-cache curl tini ca-certificates chromium git nikto perl && \
    addgroup -g 1001 appsec && adduser -u 1001 -G appsec -s /bin/sh -D appsec && \
    NUCLEI_VER=$(wget -qO- https://api.github.com/repos/projectdiscovery/nuclei/releases/latest | grep '"tag_name"' | sed 's/.*"v\(.*\)".*/\1/' || echo "3.3.7") && \
    wget -qO /tmp/nuclei.zip "https://github.com/projectdiscovery/nuclei/releases/download/v${NUCLEI_VER}/nuclei_${NUCLEI_VER}_linux_amd64.zip" && \
    unzip -o /tmp/nuclei.zip -d /usr/local/bin/ nuclei && chmod +x /usr/local/bin/nuclei && rm /tmp/nuclei.zip && \
    mkdir -p /home/appsec/.local/nuclei-templates && chown -R appsec:appsec /home/appsec || true
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
RUN chown -R appsec:appsec /app
USER appsec
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/dast-worker.js"]
