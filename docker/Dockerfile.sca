FROM node:20-alpine AS builder

RUN apk add --no-cache python3 make g++ git

WORKDIR /app

COPY scanners/package.json scanners/package-lock.json* ./
COPY scanners/tsconfig.json ./
COPY scanners/src ./src
COPY shared /shared

RUN npm ci --ignore-scripts && \
    npm run build && \
    npm prune --production

FROM node:20-alpine AS runtime

RUN apk add --no-cache curl tini ca-certificates git openssh-client && \
    addgroup -g 1001 appsec && \
    adduser -u 1001 -G appsec -s /bin/sh -D appsec

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

RUN chown -R appsec:appsec /app

USER appsec

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/sca-worker.js"]
